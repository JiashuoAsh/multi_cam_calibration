#!/usr/bin/env python3
"""
Step 5a: 采集相机到底盘标定图像

注意事项:
    1. 标定板必须固定在墙上/柱子上（不能移动！）
    2. 测量并记录标定板相对底盘的位置（写入 config/apriltag_config.json）
    3. 机器人可以在不同位置拍照（可选，拍1张也行）
    4. 采集3-5张图片即可（用于平均，提高精度）

输出:
    - images/step5/left/*.png
    - images/step5/right/*.png (可选)
"""

import cv2
import os
import time
import numpy as np
from scipy.spatial.transform import Rotation
from utils import (
    load_config,
    init_camera,
    get_aruco_dict,
    detect_apriltag_corners,
    create_apriltag_board,
    estimate_pose_apriltag,
)


def main():
    """主函数"""
    print("=" * 60)
    print("Step 5a: 采集相机到底盘标定图像")
    print("=" * 60)

    # 加载配置
    config = load_config()
    board_cfg = config["apriltag_board"]

    # 显示重要提示
    print("\n⚠️  重要提示:")
    print("  1. 标定板必须固定在墙上/柱子上（用胶带/磁铁固定）")
    print("  2. 整个采集过程中，标定板位置不能变！")
    print("  3. 机器人可以在不同位置拍照（建议3-5个位置）")
    print("  4. 每个位置确保左相机能清晰看到标定板")
    print("")

    # 检查配置
    transform_cfg = config.get("board_to_base_transform")
    if not transform_cfg:
        print("❌ 错误: config/apriltag_config.json 中缺少 board_to_base_transform 配置")
        print("\n请添加以下配置到 config/apriltag_config.json:")
        print("""
  "board_to_base_transform": {
    "translation": [2.0, 0.0, 1.2],
    "rotation_euler_deg": [0, 0, 0],
        "note": "标定板(Tag0中心)到地盘的变换 B_T_T：translation 为 Tag0 中心在底盘系的位置 [x_m,y_m,z_m]，rotation 为板坐标轴在底盘系的姿态 [roll,pitch,yaw]",
    "coordinate_system": "X右 Y上 Z前"
  }
""")
        return

    print("底盘坐标系定义: X右 Y上 Z前")
    print("\n当前配置的标定板位置:")
    print(f"  - 平移 (米): {transform_cfg['translation']}")
    print(f"  - 旋转 (度): {transform_cfg['rotation_euler_deg']}")
    print("")
    print("⚠️  如果标定板不在这个位置，请先更新配置再采集！")
    print("")

    input("确认标定板已固定，按 Enter 开始采集...")

    # 创建输出目录
    output_dir_left = "images/step5/left"
    output_dir_right = "images/step5/right"
    os.makedirs(output_dir_left, exist_ok=True)
    os.makedirs(output_dir_right, exist_ok=True)

    # 清空旧图像
    import glob
    old_files = glob.glob(f"{output_dir_left}/*.png") + glob.glob(f"{output_dir_right}/*.png")
    if old_files:
        print(f"\n清空旧图像: {len(old_files)} 张")
        for f in old_files:
            os.remove(f)

    # 加载左相机内参（用于位姿估计）
    if not os.path.exists("results/left_intrinsics.json"):
        print("\n⚠️  警告: 未找到 results/left_intrinsics.json")
        print("   无法计算实时位姿，但仍可采集图像")
        K_l = None
        dist_l = None
    else:
        import json
        with open("results/left_intrinsics.json", "r") as f:
            intrinsics_data = json.load(f)
        K_l = np.array(intrinsics_data["camera_matrix"], dtype=np.float64)
        dist_l = np.array(intrinsics_data["dist_coeffs"], dtype=np.float64)
        print("\n✓ 已加载左相机内参（可计算实时位姿）")

    # 创建标定板的3D点
    obj_points, tag_ids = create_apriltag_board(config)

    # 初始化相机
    print("\n初始化相机...")
    try:
        camera = init_camera(config)
        print("  ✓ 相机已就绪")
    except Exception as e:
        print(f"错误: 无法初始化相机: {e}")
        return

    # 设置 AprilTag 检测器
    aruco_dict = get_aruco_dict(board_cfg["family"])
    detector_params = cv2.aruco.DetectorParameters()
    detector_params.cornerRefinementMethod = cv2.aruco.CORNER_REFINE_APRILTAG

    # 采集计数
    capture_count = 0
    target_count = 50  # 建议采集5张
    capture_interval = 0.5  # 自动拍照间隔（秒）

    print("\n" + "=" * 60)
    print(f"开始自动采集 (目标: {target_count} 张)")
    print("=" * 60)
    print(f"\n自动拍照模式（无GUI显示）:")
    print(f"  - 拍照间隔: {capture_interval} 秒")
    print(f"  - 机器人可以在不同位置等待拍照")
    print(f"  - 按 Ctrl+C 可提前终止")
    print("-" * 60)

    try:
        while capture_count < target_count:
            # 读取图像
            left_img, right_img, timestamp = camera.read_stereo()

            if left_img is None or right_img is None:
                print("警告: 读取图像失败，等待下次尝试...")
                time.sleep(1)
                continue

            # 检测 AprilTag（左相机）
            left_gray = cv2.cvtColor(left_img, cv2.COLOR_BGR2GRAY)
            left_corners, left_ids = detect_apriltag_corners(
                left_gray, aruco_dict, detector_params, use_multiscale=True
            )

            # 计算相机到标定板的位姿（如果有内参）
            pose_info = ""
            if left_ids is not None and K_l is not None:
                success, rvec, tvec = estimate_pose_apriltag(
                    left_corners, left_ids, obj_points, tag_ids, K_l, dist_l
                )

                if success:
                    # 转换为旋转矩阵
                    R_cam_board, _ = cv2.Rodrigues(rvec)

                    # 转换为欧拉角 (XYZ顺序)
                    rot = Rotation.from_matrix(R_cam_board)
                    euler_deg = rot.as_euler('xyz', degrees=True)

                    # tvec 单位是毫米，转为米
                    t_m = tvec.flatten() / 1000.0

                    # 准备显示信息（solvePnP 返回的是 T -> Cl 变换）
                    # 命名规范: Cl_T_T 表示 "T -> Cl" (标定板坐标系 -> 相机坐标系)
                    pose_info = (
                        f"\n   Board->Camera (T->Cl, OpenCV coords):"
                        f"\n     T: [{t_m[0]:6.3f}, {t_m[1]:6.3f}, {t_m[2]:6.3f}] m"
                        f"\n     R: [{euler_deg[0]:6.1f}, {euler_deg[1]:6.1f}, {euler_deg[2]:6.1f}] deg"
                    )

            # 生成文件名
            timestamp_str = time.strftime("%Y%m%d_%H%M%S")
            filename = f"{timestamp_str}_{capture_count+1:03d}.png"

            # 保存左右图像
            left_path = os.path.join(output_dir_left, filename)
            right_path = os.path.join(output_dir_right, filename)

            cv2.imwrite(left_path, left_img)
            cv2.imwrite(right_path, right_img)

            capture_count += 1

            # 显示保存信息
            tag_count = 0 if left_ids is None else len(left_ids)
            status = "✅" if tag_count >= 10 else "⚠️"
            print(
                f"{status} 已保存 #{capture_count}/{target_count}: {filename} "
                f"(检测到 {tag_count} 个标签){pose_info}"
            )

            if capture_count >= target_count:
                print(f"\n已达到目标数量 ({target_count})，自动退出")
                break

            # 等待指定间隔后继续拍照
            time.sleep(capture_interval)

    except KeyboardInterrupt:
        print("\n\n用户中断 (Ctrl+C)")

    # 清理
    camera.release()

    # 总结
    print("\n" + "=" * 60)
    print("采集完成！")
    print("=" * 60)
    print(f"\n采集统计:")
    print(f"  - 左相机图像: {capture_count} 张")
    print(f"  - 保存位置: {output_dir_left}/")

    if capture_count < 1:
        print("\n❌ 错误: 没有采集到任何图像")
        print("   请重新运行")
    elif capture_count < 3:
        print(f"\n⚠️  警告: 只采集了 {capture_count} 张图像")
        print("   建议至少采集 3 张（在不同位置拍摄）")
    else:
        print(f"\n✅ 采集完成，可以运行下一步:")
        print(f"   python3 step5b_camera_to_base.py")


if __name__ == "__main__":
    main()
